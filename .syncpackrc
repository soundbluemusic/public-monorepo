{
  "versionGroups": [
    {
      "label": "Use workspace protocol for local packages",
      "dependencies": ["@soundblue/*"],
      "dependencyTypes": ["dev", "prod"],
      "pinVersion": "workspace:*"
    },
    {
      "label": "Pin zod to current project major",
      "dependencies": ["zod"],
      "dependencyTypes": ["dev", "prod"],
      "pinVersion": "^4.6.6"
    },
    {
      "label": "Keep Astro apps on the latest TypeScript supported by astro check",
      "packages": ["context", "permissive", "roots"],
      "dependencies": ["typescript"],
      "dependencyTypes": ["dev"],
      "pinVersion": "^6.0.3"
    }
  ],
  "semverGroups": [
    {
      "label": "Keep verified Astro and Vitest patch releases exact",
      "range": "",
      "dependencies": ["astro", "vitest", "@vitest/coverage-v8"],
      "dependencyTypes": ["dev", "prod"]
    },
    {
      "range": "^",
      "dependencyTypes": ["dev", "prod"],
      "dependencies": ["**"]
    }
  ]
}
