---
import {
  getCategoryBySlug,
  getLibrarySlug,
  getLibrariesByCategorySlug,
  resolveCategorySlug,
} from '../../../app/data/libraries';
import AppShell from '../../components/AppShell.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { categoryId } = Astro.params;
if (!categoryId) return Astro.redirect('/libraries', 302);

// Phase 2 카테고리 통폐합 (25 → 10) 이전 slug면 새 slug로 301 redirect.
const resolved = resolveCategorySlug(categoryId);
if (!resolved) return Astro.redirect('/libraries', 302);
if (resolved !== categoryId) return Astro.redirect(`/category/${resolved}`, 301);

const category = getCategoryBySlug(resolved);
if (!category) return Astro.redirect('/libraries', 302);

const libs = getLibrariesByCategorySlug(resolved);
const baseUrl = 'https://permissive.soundbluemusic.com';
---

<BaseLayout
  title={`${category.name.en} Libraries - Permissive`}
  description={category.description.en}
  canonical={`${baseUrl}/category/${resolved}`}
>
  <AppShell>
    <div class="mb-6">
      <nav aria-label="Breadcrumb" class="mb-4">
        <ol class="flex items-center gap-1.5 text-sm text-(--text-tertiary)">
          <li><a href="/" class="hover:text-(--text-primary) transition-colors">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/libraries" class="hover:text-(--text-primary) transition-colors">Libraries</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-(--text-primary) font-medium">{category.name.en}</li>
        </ol>
      </nav>
      <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) mb-2">
        {category.name.en}
      </h1>
      <p class="text-(--text-secondary)">{category.description.en}</p>
      <p class="text-sm text-(--text-tertiary) mt-1">{libs.length} libraries</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {libs.map((lib) => (
        <a
          href={`/library/${getLibrarySlug(lib.name)}`}
          class="p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--border-focus) transition-colors group"
        >
          <div class="flex items-start justify-between gap-2 mb-2">
            <h2 class="font-semibold text-(--text-primary) group-hover:text-(--accent-primary) transition-colors">
              {lib.name}
            </h2>
            <span class="text-xs text-(--text-tertiary) shrink-0">★ {lib.stars}</span>
          </div>
          <p class="text-sm text-(--text-secondary) line-clamp-2 mb-3">{lib.description}</p>
          <span class="px-2 py-0.5 rounded text-xs bg-(--bg-tertiary) text-(--text-tertiary)">
            {lib.license}
          </span>
        </a>
      ))}
    </div>
  </AppShell>
</BaseLayout>
