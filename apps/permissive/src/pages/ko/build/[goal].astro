---
import { getGoalById, getLibrariesForGoal } from '../../../../app/data/goals';
import { getLibrarySlug } from '../../../../app/data/libraries';
import AppShell from '../../../components/AppShell.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const { goal: goalId } = Astro.params;
if (!goalId) return Astro.redirect('/ko/build', 302);

const goal = getGoalById(goalId);
if (!goal) return Astro.redirect('/ko/build', 302);

const libs = getLibrariesForGoal(goal);
const baseUrl = 'https://permissive.soundbluemusic.com';
---

<BaseLayout
  title={`${goal.name.ko} — 빌드 가이드 | Permissive`}
  description={goal.tagline.ko}
  canonical={`${baseUrl}/ko/build/${goal.id}`}
>
  <AppShell locale="ko">
    <nav aria-label="이동 경로" class="mb-6">
      <ol class="flex items-center gap-1.5 text-sm text-(--text-tertiary)">
        <li><a href="/ko" class="hover:text-(--text-primary) transition-colors">홈</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/ko/build" class="hover:text-(--text-primary) transition-colors">빌드</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-(--text-primary) font-medium">{goal.name.ko}</li>
      </ol>
    </nav>

    <header class="mb-10">
      <p class="text-5xl mb-3" aria-hidden="true">{goal.icon}</p>
      <h1 class={`text-3xl sm:text-4xl font-bold ${goal.accent} mb-3`}>
        {goal.name.ko}
      </h1>
      <p class="text-lg text-(--text-secondary) max-w-2xl mb-4">{goal.tagline.ko}</p>
      <p class="text-(--text-secondary) max-w-3xl leading-relaxed">{goal.hero.ko}</p>
    </header>

    <section class="mb-12" aria-labelledby="steps-heading">
      <h2 id="steps-heading" class="text-2xl font-bold text-(--text-primary) mb-4">
        시작하기
      </h2>
      <ol class="space-y-4">
        {goal.steps.map((step, idx) => (
          <li class="flex gap-4">
            <span class={`shrink-0 w-8 h-8 rounded-full ${goal.accent.replace('text-', 'bg-')}/10 ${goal.accent} flex items-center justify-center font-semibold text-sm`}>
              {idx + 1}
            </span>
            <div>
              <h3 class="font-semibold text-(--text-primary) mb-1">{step.title.ko}</h3>
              <p class="text-sm text-(--text-secondary) leading-relaxed">{step.description.ko}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="libs-heading">
      <h2 id="libs-heading" class="text-2xl font-bold text-(--text-primary) mb-1">
        추천 라이브러리
      </h2>
      <p class="text-sm text-(--text-tertiary) mb-4">
        이 목적에 적합한 순서로 {libs.length}개 라이브러리
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {libs.map((lib) => (
          <a
            href={`/ko/library/${getLibrarySlug(lib.name)}`}
            class="p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--border-focus) transition-colors group"
          >
            <div class="flex items-start justify-between gap-2 mb-2">
              <h3 class="font-semibold text-(--text-primary) group-hover:text-(--accent-primary) transition-colors">
                {lib.name}
              </h3>
              <span class="text-xs text-(--text-tertiary) shrink-0">★ {lib.stars}</span>
            </div>
            <p class="text-sm text-(--text-secondary) line-clamp-2 mb-3">
              {lib.descriptionKo}
            </p>
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-2 py-0.5 rounded text-xs bg-(--bg-tertiary) text-(--text-tertiary)">
                {lib.license}
              </span>
              {lib.categories.map((cat) => (
                <span class="px-2 py-0.5 rounded text-xs bg-(--bg-tertiary) text-(--text-tertiary)">
                  {cat}
                </span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-12 p-5 rounded-xl bg-(--bg-tertiary) border border-(--border-primary)">
      <p class="text-sm text-(--text-secondary)">
        🤔 <strong>다른 목적이 있나요?</strong> <a href="/ko/build" class="text-(--accent-primary) hover:underline">6가지 빌드 가이드</a>를 모두 보거나 전체 <a href="/ko/libraries" class="text-(--accent-primary) hover:underline">라이브러리 카탈로그</a>를 둘러보세요.
      </p>
    </section>
  </AppShell>
</BaseLayout>
