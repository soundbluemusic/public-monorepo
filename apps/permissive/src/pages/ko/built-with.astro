---
import { libraries } from '../../../app/data/libraries';
import AppShell from '../../components/AppShell.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const usedLibs = libraries.filter((l) => l.usedHere);
const baseUrl = 'https://permissive.soundbluemusic.com';
---

<BaseLayout
  title="오픈소스 - Permissive"
  description="이 사이트를 만드는 데 사용된 오픈소스 프로젝트"
  canonical={`${baseUrl}/ko/built-with`}
>
  <AppShell locale="ko">
    <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) mb-2">오픈소스</h1>
    <p class="text-(--text-secondary) mb-8">
      이 사이트는 오픈소스 도구로 만들어졌습니다. 오픈소스에 기여합니다.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {usedLibs.map((lib) => (
        <a
          href={lib.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--border-focus) transition-colors group"
        >
          <div class="flex items-start justify-between gap-2 mb-2">
            <h2 class="font-semibold text-(--text-primary) group-hover:text-(--accent-primary) transition-colors">
              {lib.name}
            </h2>
            <span class="text-xs text-(--text-tertiary) shrink-0">★ {lib.stars}</span>
          </div>
          <p class="text-sm text-(--text-secondary) line-clamp-2 mb-3">{lib.descriptionKo}</p>
          <span class="px-2 py-0.5 rounded text-xs bg-(--bg-tertiary) text-(--text-tertiary)">
            {lib.license}
          </span>
        </a>
      ))}
    </div>
  </AppShell>
</BaseLayout>
