---
import { getLibrariesByTag, getLibrarySlug } from '../../../../app/data/libraries';
import AppShell from '../../../components/AppShell.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const { tagId } = Astro.params;
if (!tagId) return Astro.redirect('/ko/tags', 302);

const tag = decodeURIComponent(tagId);
const libs = getLibrariesByTag(tag);
const baseUrl = 'https://permissive.soundbluemusic.com';
---

<BaseLayout
  title={`${tag} 라이브러리 - Permissive`}
  description={`${tag} 태그가 붙은 오픈소스 라이브러리`}
  canonical={`${baseUrl}/ko/tag/${tagId}`}
>
  <AppShell locale="ko">
    <div class="mb-6">
      <nav aria-label="이동 경로" class="mb-4">
        <ol class="flex items-center gap-1.5 text-sm text-(--text-tertiary)">
          <li><a href="/ko" class="hover:text-(--text-primary) transition-colors">홈</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/ko/tags" class="hover:text-(--text-primary) transition-colors">태그</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-(--text-primary) font-medium">{tag}</li>
        </ol>
      </nav>
      <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) mb-1">{tag}</h1>
      <p class="text-sm text-(--text-tertiary)">{libs.length}개 라이브러리</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {libs.map((lib) => (
        <a
          href={`/ko/library/${getLibrarySlug(lib.name)}`}
          class="p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--border-focus) transition-colors group"
        >
          <div class="flex items-start justify-between gap-2 mb-2">
            <h2 class="font-semibold text-(--text-primary) group-hover:text-(--accent-primary) transition-colors">
              {lib.name}
            </h2>
            <span class="text-xs text-(--text-tertiary) shrink-0">★ {lib.stars}</span>
          </div>
          <p class="text-sm text-(--text-secondary) line-clamp-2">{lib.descriptionKo}</p>
        </a>
      ))}
    </div>
  </AppShell>
</BaseLayout>
