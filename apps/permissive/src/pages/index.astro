---
import { goals } from '../../app/data/goals';
import { getLibrarySlug, libraries } from '../../app/data/libraries';
import { webApis } from '../../app/data/web-apis';
import AppShell from '../components/AppShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = 'https://permissive.soundbluemusic.com';
const trending = libraries.filter((l) => l.trending).slice(0, 6);
const usedHere = libraries.filter((l) => l.usedHere).slice(0, 4);
---

<BaseLayout
  title="Permissive - Open Web Dev Resources"
  description="Web Standard APIs and open-source web development libraries at a glance"
  canonical={baseUrl}
>
  <AppShell>
    <!-- Hero -->
    <section class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-(--text-primary) mb-4">
        Open Web Dev<br />
        <span class="text-(--accent-primary)">Resources</span>
      </h1>
      <p class="text-lg text-(--text-secondary) mb-6 max-w-xl">
        Web Standard APIs and open-source libraries with license metadata.
      </p>
      <!-- Search form (form: no-JS fallback; data-search-trigger: opens
           SearchDialog when JS is active). -->
      <form method="get" action="/libraries" class="flex gap-2 max-w-lg">
        <div class="relative flex-1">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="absolute left-3 top-1/2 -translate-y-1/2 text-(--text-tertiary)"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            type="search"
            name="q"
            placeholder="Search libraries and Web APIs..."
            data-search-trigger
            readonly
            class="w-full pl-10 pr-16 py-2.5 rounded-xl border border-(--border-primary) bg-(--bg-elevated) text-(--text-primary) placeholder:text-(--text-tertiary) focus:outline-none focus:border-(--border-focus) transition-colors cursor-pointer"
          />
          <kbd class="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-(--text-tertiary) bg-(--bg-tertiary) px-1.5 py-0.5 rounded border border-(--border-primary)">
            ⌘K
          </kbd>
        </div>
        <button
          type="submit"
          class="px-4 py-2.5 rounded-xl bg-(--accent-bg) text-white font-medium hover:opacity-90 transition-opacity text-sm"
        >
          Search
        </button>
      </form>
    </section>

    <!-- What do you want to build? -->
    <section class="mb-12" aria-labelledby="build-heading">
      <div class="flex items-baseline justify-between mb-4">
        <h2 id="build-heading" class="text-xl font-semibold text-(--text-primary)">
          What do you want to build?
        </h2>
        <a href="/build" class="text-sm text-(--accent-primary) hover:underline">
          See all 6 →
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        {goals.map((goal) => (
          <a
            href={`/build/${goal.id}`}
            class="group p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--border-focus) transition-colors"
          >
            <p class="text-2xl mb-1.5" aria-hidden="true">{goal.icon}</p>
            <p class={`font-semibold ${goal.accent} group-hover:underline text-sm`}>
              {goal.name.en}
            </p>
            <p class="text-xs text-(--text-tertiary) line-clamp-1 mt-0.5">
              {goal.tagline.en}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Quick nav cards -->
    <section class="mb-12" aria-labelledby="explore-heading">
      <h2 id="explore-heading" class="text-xl font-semibold text-(--text-primary) mb-4">
        Explore
      </h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        <a
          href="/libraries"
          class="p-5 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--border-focus) transition-colors group"
        >
          <p class="text-2xl mb-2">📚</p>
          <p class="font-semibold text-(--text-primary) group-hover:text-(--accent-primary) transition-colors">
            Libraries
          </p>
          <p class="text-sm text-(--text-secondary)">{libraries.length} packages</p>
        </a>
        <a
          href="/web-api"
          class="p-5 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--border-focus) transition-colors group"
        >
          <p class="text-2xl mb-2">🌐</p>
          <p class="font-semibold text-(--text-primary) group-hover:text-(--accent-primary) transition-colors">
            Web APIs
          </p>
          <p class="text-sm text-(--text-secondary)">{webApis.length} APIs</p>
        </a>
        <a
          href="/tags"
          class="p-5 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--border-focus) transition-colors group"
        >
          <p class="text-2xl mb-2">🏷️</p>
          <p class="font-semibold text-(--text-primary) group-hover:text-(--accent-primary) transition-colors">
            Tags
          </p>
          <p class="text-sm text-(--text-secondary)">Browse by tag</p>
        </a>
      </div>
    </section>

    <!-- Trending -->
    {trending.length > 0 && (
      <section class="mb-12" aria-labelledby="trending-heading">
        <h2 id="trending-heading" class="text-xl font-semibold text-(--text-primary) mb-4">
          🔥 Trending
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {trending.map((lib) => (
            <a
              href={`/library/${getLibrarySlug(lib.name)}`}
              class="flex items-start gap-3 p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--border-focus) transition-colors group"
            >
              <div class="flex-1 min-w-0">
                <p class="font-medium text-(--text-primary) group-hover:text-(--accent-primary) transition-colors truncate">
                  {lib.name}
                </p>
                <p class="text-sm text-(--text-secondary) line-clamp-1 mt-0.5">
                  {lib.description}
                </p>
              </div>
              <span class="text-xs text-(--text-tertiary) shrink-0 mt-0.5">★ {lib.stars}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Used here -->
    {usedHere.length > 0 && (
      <section aria-labelledby="used-here-heading">
        <h2 id="used-here-heading" class="text-xl font-semibold text-(--text-primary) mb-4">
          ✨ Used to build this site
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {usedHere.map((lib) => (
            <a
              href={`/library/${getLibrarySlug(lib.name)}`}
              class="flex items-start gap-3 p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--border-focus) transition-colors group"
            >
              <div class="flex-1 min-w-0">
                <p class="font-medium text-(--text-primary) group-hover:text-(--accent-primary) transition-colors truncate">
                  {lib.name}
                </p>
                <p class="text-sm text-(--text-secondary) line-clamp-1 mt-0.5">
                  {lib.description}
                </p>
              </div>
              <span class="text-xs text-(--text-tertiary) shrink-0 mt-0.5">★ {lib.stars}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </AppShell>
</BaseLayout>
