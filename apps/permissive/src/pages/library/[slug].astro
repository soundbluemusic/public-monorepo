---
import { getLibraryBySlug } from '../../../app/data/libraries';
import LibraryPage from '../../components/pages/LibraryPage.astro';

const { slug } = Astro.params;
if (!slug) return Astro.rewrite('/404');
if (!getLibraryBySlug(slug)) return Astro.rewrite('/404');
---

<LibraryPage slug={slug} locale="en" />
