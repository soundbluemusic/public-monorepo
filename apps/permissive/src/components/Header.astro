---
import { buildLocalePath, getLocaleFromPath, stripLocaleFromPath } from '@soundblue/i18n';
import { MOON_ICON_SVG, SUN_ICON_SVG } from '@soundblue/ui/utils';

interface Props {
  locale?: 'en' | 'ko';
}

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const detectedLocale = locale ?? (getLocaleFromPath(pathname) as 'en' | 'ko');
const isKo = detectedLocale === 'ko';

const basePath = stripLocaleFromPath(pathname);
const altLocalePath = isKo ? basePath || '/' : buildLocalePath(basePath || '/', 'ko');
const altLocaleLabel = isKo ? 'EN' : '한국어';
const altLocaleAriaLabel = isKo ? 'View in English' : '한국어로 보기';

const navItems = [
  { name: isKo ? '홈' : 'Home', path: isKo ? '/ko' : '/' },
  { name: isKo ? '라이브러리' : 'Libraries', path: isKo ? '/ko/libraries' : '/libraries' },
  { name: 'Web API', path: isKo ? '/ko/web-api' : '/web-api' },
];
const navLinkClass = (path: string) =>
  `px-3 py-1.5 rounded-lg text-sm font-medium transition-colors ${
    pathname === path
      ? 'text-(--text-primary) bg-(--bg-tertiary)'
      : 'text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--bg-tertiary)'
  }`;
---

<header
  class="fixed top-0 left-0 right-0 h-header bg-(--bg-elevated) border-b border-(--border-primary) z-header"
>
  <div
    class="h-full flex items-center justify-between px-4 lg:pl-[calc(var(--sidebar-width)+1rem)] transition-[padding] duration-200"
    id="header-inner"
  >
    <!-- Mobile: Hamburger button -->
    <button
      aria-label="Open Menu"
      class="lg:hidden p-2 rounded-lg hover:bg-(--bg-tertiary) text-(--text-secondary) transition-colors mr-2"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <line x1="4" x2="20" y1="12" y2="12"></line>
        <line x1="4" x2="20" y1="6" y2="6"></line>
        <line x1="4" x2="20" y1="18" y2="18"></line>
      </svg>
    </button>

    <!-- Logo -->
    <a
      href={isKo ? '/ko' : '/'}
      class="flex items-center gap-2 font-bold text-(--text-primary) text-lg shrink-0"
    >
      <span class="text-(--accent-primary)">P</span>ermissive
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-1 ml-8 flex-1" aria-label="Main navigation">
      {
        navItems.map((item) => (
          <a
            href={item.path}
            class={navLinkClass(item.path)}
            aria-current={pathname === item.path ? 'page' : undefined}
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <!-- Right controls -->
    <div class="flex items-center gap-1 ml-auto">
      <!-- Search trigger (Cmd+K) -->
      <button
        type="button"
        data-search-trigger
        aria-label={isKo ? '검색 (⌘K)' : 'Search (⌘K)'}
        title={isKo ? '검색 (⌘K)' : 'Search (⌘K)'}
        class="hidden sm:inline-flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-sm text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--bg-tertiary) transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
        </svg>
        <kbd class="text-xs text-(--text-tertiary) bg-(--bg-tertiary) px-1.5 py-0.5 rounded border border-(--border-primary)">⌘K</kbd>
      </button>

      <!-- Mobile search icon -->
      <button
        type="button"
        data-search-trigger
        aria-label={isKo ? '검색' : 'Search'}
        class="sm:hidden p-2 rounded-lg text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--bg-tertiary) transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
        </svg>
      </button>

      <!-- Language toggle -->
      <a
        href={altLocalePath}
        aria-label={altLocaleAriaLabel}
        class="px-2.5 py-1.5 rounded-lg text-sm font-medium text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--bg-tertiary) transition-colors"
      >
        {altLocaleLabel}
      </a>

      <!-- Dark mode toggle -->
      <button
        aria-label="Switch to dark mode"
        title="Toggle dark mode"
        class="p-2 rounded-lg text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--bg-tertiary) transition-colors"
      >
        <span class="theme-icon--sun" set:html={SUN_ICON_SVG} />
        <span class="theme-icon--moon" set:html={MOON_ICON_SVG} />
      </button>
    </div>
  </div>
</header>
