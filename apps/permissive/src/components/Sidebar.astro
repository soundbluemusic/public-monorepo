---
import { getLocaleFromPath } from '@soundblue/i18n';
import { goals } from '../../app/data/goals';
import { categoryMeta } from '../../app/data/libraries';
import { PANEL_LEFT_CLOSE_SVG, PANEL_LEFT_OPEN_SVG } from '@soundblue/ui/utils';

interface Props {
  locale?: 'en' | 'ko';
}

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const detectedLocale = locale ?? (getLocaleFromPath(pathname) as 'en' | 'ko');
const isKo = detectedLocale === 'ko';
const prefix = isKo ? '/ko' : '';

const navItems = [
  {
    name: isKo ? '홈' : 'Home',
    path: `${prefix}/`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
  },
  {
    name: isKo ? '빌드 가이드' : 'Build',
    path: `${prefix}/build`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
  },
  {
    name: isKo ? '라이브러리' : 'Libraries',
    path: `${prefix}/libraries`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>',
  },
  {
    name: 'Web API',
    path: `${prefix}/web-api`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>',
  },
  {
    name: isKo ? '태그' : 'Tags',
    path: `${prefix}/tags`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/><circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/></svg>',
  },
  {
    name: isKo ? '저장' : 'Favorites',
    path: `${prefix}/favorites`,
    icon: '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>',
  },
];
---

<!-- Sidebar backdrop (mobile) -->
<div
  data-sidebar-backdrop
  class="fixed inset-0 bg-black/50 z-overlay lg:hidden hidden"
  aria-hidden="true"
></div>

<aside
  data-sidebar
  aria-label="Site navigation"
  class="fixed top-0 left-0 bottom-0 w-sidebar bg-(--bg-elevated) border-r border-(--border-primary) z-sidebar flex flex-col overflow-hidden transition-transform duration-200"
>
  <!-- Sidebar header: logo + collapse button -->
  <div
    class="h-header flex items-center justify-between px-3 border-b border-(--border-primary) shrink-0"
  >
    <a href={isKo ? '/ko' : '/'} class="flex items-center gap-2 font-bold text-(--text-primary)">
      <span class="text-(--accent-primary) text-lg">P</span>
      <span class="sidebar-label text-base">ermissive</span>
    </a>
    <!-- Desktop collapse toggle -->
    <button
      aria-label="Toggle sidebar collapse"
      title="Collapse sidebar"
      class="hidden lg:flex p-1.5 rounded-lg text-(--text-tertiary) hover:text-(--text-primary) hover:bg-(--bg-tertiary) transition-colors"
    >
      <span class="sidebar-label" set:html={PANEL_LEFT_CLOSE_SVG} />
      <span class="hidden sidebar-collapsed-icon" set:html={PANEL_LEFT_OPEN_SVG} />
    </button>
    <!-- Mobile close button -->
    <button
      aria-label="Close navigation"
      class="lg:hidden p-1.5 rounded-lg text-(--text-tertiary) hover:text-(--text-primary) hover:bg-(--bg-tertiary) transition-colors"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Nav -->
  <nav class="flex-1 overflow-y-auto p-2 scrollbar-none" aria-label="Sidebar navigation">
    <ul class="space-y-0.5">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.path}
              class="flex items-center gap-2.5 px-2.5 py-2 rounded-lg text-sm font-medium text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--bg-tertiary) transition-colors group"
              aria-current={pathname === item.path ? 'page' : undefined}
            >
              <span class="shrink-0" set:html={item.icon} />
              <span class="sidebar-label truncate">{item.name}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Quick Build section: goals 6개를 사이드바에서도 즉시 접근 -->
    <div class="mt-4 sidebar-label">
      <p class="px-2.5 py-1 text-xs font-semibold text-(--text-tertiary) uppercase tracking-wider">
        {isKo ? '빌드 가이드' : 'Build by goal'}
      </p>
      <ul class="mt-1 space-y-0.5">
        {
          goals.map((goal) => (
            <li>
              <a
                href={`${prefix}/build/${goal.id}`}
                class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-sm text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--bg-tertiary) transition-colors"
              >
                <span class="shrink-0" aria-hidden="true">{goal.icon}</span>
                <span class="truncate">{isKo ? goal.name.ko : goal.name.en}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Category section -->
    <div class="mt-4 sidebar-label">
      <p class="px-2.5 py-1 text-xs font-semibold text-(--text-tertiary) uppercase tracking-wider">
        {isKo ? '카테고리' : 'Categories'}
      </p>
      <ul class="mt-1 space-y-0.5">
        {
          categoryMeta.map((cat) => (
            <li>
              <a
                href={`${prefix}/category/${cat.id}`}
                class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-sm text-(--text-secondary) hover:text-(--text-primary) hover:bg-(--bg-tertiary) transition-colors"
              >
                <span class="truncate">
                  {isKo ? cat.name.ko : cat.name.en}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</aside>

<script is:inline>
  // Sync sidebar-collapsed icon state on desktop
  (function () {
    var html = document.documentElement;
    var sidebar = document.querySelector('aside[data-sidebar]');
    if (!sidebar) return;
    function syncIcons() {
      var collapsed = html.classList.contains('sidebar-collapsed');
      sidebar.querySelectorAll('.sidebar-collapsed-icon').forEach(function (el) {
        el.style.display = collapsed ? 'inline-flex' : 'none';
      });
    }

    syncIcons();
    window.addEventListener('sidebar-collapse-change', syncIcons);
  })();
</script>
