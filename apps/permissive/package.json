{
  "name": "permissive",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "웹 개발 리소스 가이드 - 웹 표준 API와 라이선스 메타데이터가 있는 오픈소스 정리",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "tsx scripts/generate-search-index.ts",
    "build": "astro build && node scripts/strip-bindings.mjs",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy",
    "start": "wrangler dev",
    "data:fetch": "pnpm run data:fetch:npm && pnpm run data:fetch:github && pnpm run data:fetch:bundle",
    "data:fetch:npm": "tsx scripts/fetch-npm-data.ts",
    "data:fetch:github": "tsx scripts/fetch-github-data.ts",
    "data:fetch:bundle": "tsx scripts/fetch-bundlephobia.ts",
    "data:build": "tsx scripts/build-data.ts && tsx scripts/calc-rankings.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/react": "^6.0.5",
    "@soundblue/config": "workspace:*",
    "@soundblue/core": "workspace:*",
    "@soundblue/i18n": "workspace:*",
    "@soundblue/search": "workspace:*",
    "@soundblue/seo": "workspace:*",
    "@soundblue/ui": "workspace:*",
    "astro": "^7.3.1",
    "nanostores": "^1.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260906.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=20"
  }
}
