---
import { conceptsByTag, allTags } from '../../../app/data/concepts';
import AppShell from '../../components/AppShell.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { difficultyLabels } from '../../../app/data/types';

const { tagId } = Astro.params;
if (!tagId) return Astro.redirect('/404', 404);

const tag = decodeURIComponent(tagId);
const concepts = conceptsByTag.get(tag) ?? [];
if (concepts.length === 0) return Astro.redirect('/404', 404);

const baseUrl = 'https://roots.soundbluemusic.com';

const relatedTagCounts = new Map<string, number>();
for (const concept of concepts) {
  for (const t of concept.tags) {
    if (t !== tag) relatedTagCounts.set(t, (relatedTagCounts.get(t) ?? 0) + 1);
  }
}
const relatedTags = Array.from(relatedTagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<BaseLayout
  title={`#${tag} Tag | Roots`}
  description={`${concepts.length} math concepts tagged with "${tag}"`}
  canonical={`${baseUrl}/tag/${encodeURIComponent(tag)}`}
>
  <AppShell locale="en">
    <!-- Header -->
    <header class="mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) mb-2">#{tag}</h1>
      <p class="text-(--text-secondary)">
        {concepts.length} concept{concepts.length !== 1 ? 's' : ''}
      </p>
    </header>

    <!-- Related tags -->
    {relatedTags.length > 0 && (
      <section class="mb-8">
        <h2 class="text-sm font-semibold text-(--text-tertiary) uppercase tracking-wider mb-3">
          Related Tags
        </h2>
        <div class="flex flex-wrap gap-2">
          {relatedTags.map(([t, count]) => (
            <a
              href={`/tag/${encodeURIComponent(t)}`}
              class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-sm bg-(--bg-elevated) border border-(--border-primary) text-(--text-secondary) hover:border-(--accent-primary) hover:text-(--text-primary) transition-colors"
            >
              #{t}
              <span class="text-xs text-(--text-tertiary)">{count}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Concept list -->
    <section>
      <h2 class="text-lg font-semibold text-(--text-primary) mb-4">Concepts</h2>
      <div class="grid gap-3">
        {concepts.map((concept) => {
          const def = typeof concept.content.en === 'string'
            ? concept.content.en
            : concept.content.en?.definition ?? '';
          const diffLabel = difficultyLabels[concept.difficulty]?.en ?? String(concept.difficulty);
          return (
            <a
              href={`/concept/${concept.id}`}
              class="block p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--accent-primary) transition-colors"
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1 min-w-0">
                  <h3 class="font-medium text-(--text-primary) truncate">{concept.name.en}</h3>
                  <p class="text-sm text-(--text-secondary) mt-1 line-clamp-2">{def}</p>
                </div>
                <span class="px-1.5 py-0.5 rounded text-xs bg-(--accent-mint) text-(--accent-primary) shrink-0">
                  {diffLabel}
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Back to tags -->
    <div class="mt-8 pt-8 border-t border-(--border-primary)">
      <a href="/tags" class="text-sm text-(--accent-primary) hover:underline">
        ← View all tags
      </a>
    </div>
  </AppShell>
</BaseLayout>
