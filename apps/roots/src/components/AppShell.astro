---
import AppShellFrame from '@soundblue/ui/astro/AppShellFrame.astro';
import Header from './Header.astro';
import Sidebar from './Sidebar.astro';

interface Props {
  locale?: 'en' | 'ko';
}

const { locale } = Astro.props;
---

<AppShellFrame locale={locale}>
  <Header slot="header" locale={locale} />
  <Sidebar slot="sidebar" locale={locale} />
  <slot />
</AppShellFrame>
