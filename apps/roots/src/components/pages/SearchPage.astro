---
import { lightConcepts } from '../../../app/data/concepts';
import { searchConcepts } from '../../../app/lib/concept-filters';
import { difficultyLabels } from '../../../app/data/types';
import AppShell from '../AppShell.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  locale: 'en' | 'ko';
}

const { locale } = Astro.props;
const isKo = locale === 'ko';
const localePrefix = isKo ? '/ko' : '';
const q = Astro.url.searchParams.get('q') ?? '';
const results = searchConcepts(lightConcepts, q, locale);
const BASE_URL = 'https://roots.soundbluemusic.com';
---

<BaseLayout
  title={isKo ? '검색 - 수리' : 'Search - Roots'}
  description={isKo ? '수학 개념 검색' : 'Search math concepts'}
  canonical={`${BASE_URL}${localePrefix}/search`}
  noIndex={true}
>
  <AppShell locale={locale}>
    <h1 class="text-2xl font-bold text-(--text-primary) mb-6">{isKo ? '검색' : 'Search'}</h1>

    <form method="get" action={`${localePrefix}/search`} class="mb-6 flex gap-2">
      <div class="relative flex-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="absolute left-3 top-1/2 -translate-y-1/2 text-(--text-tertiary)"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="search"
          name="q"
          value={q}
          placeholder={isKo ? '수학 개념 검색...' : 'Search math concepts...'}
          autofocus
          class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-(--border-primary) bg-(--bg-elevated) text-(--text-primary) placeholder:text-(--text-tertiary) focus:outline-none focus:border-(--border-focus) transition-colors"
        />
      </div>
      <button
        type="submit"
        class="px-4 py-2.5 rounded-xl bg-(--accent-primary) text-white font-medium hover:opacity-90 transition-opacity"
      >
        {isKo ? '검색' : 'Search'}
      </button>
    </form>

    {q && q.length >= 2 && (
      <div>
        <p class="text-sm text-(--text-tertiary) mb-4">
          {isKo ? (
            <>"<strong class="text-(--text-primary)">{q}</strong>" 검색 결과 {results.length}개</>
          ) : (
            <>{results.length} result{results.length !== 1 ? 's' : ''} for <strong class="text-(--text-primary)">"{q}"</strong></>
          )}
        </p>
        {results.length === 0 ? (
          <div class="text-center py-16">
            <p class="text-(--text-tertiary)">
              {isKo ? <><strong>"{q}"</strong>에 대한 결과가 없습니다</> : <>No results found for <strong>"{q}"</strong></>}
            </p>
            <p class="text-sm text-(--text-tertiary) mt-2">
              {isKo ? (
                <><a href="/ko/browse" class="text-(--accent-primary) hover:underline">분야별 탐색</a>해 보세요</>
              ) : (
                <>Try different keywords or <a href="/browse" class="text-(--accent-primary) hover:underline">browse by field</a></>
              )}
            </p>
          </div>
        ) : (
          <div class="grid gap-3 sm:grid-cols-2">
            {results.map((concept) => (
              <a
                href={`${localePrefix}/concept/${concept.id}`}
                class="block p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--accent-primary) transition-colors group"
              >
                <div class="flex items-start justify-between gap-2 mb-1.5">
                  <h2 class="text-sm font-semibold text-(--text-primary) group-hover:text-(--accent-primary) transition-colors">
                    {concept.name[locale]}
                  </h2>
                  <span class="px-1.5 py-0.5 rounded text-xs bg-(--accent-mint) text-(--accent-primary) shrink-0">
                    {difficultyLabels[concept.difficulty]?.[locale] ?? String(concept.difficulty)}
                  </span>
                </div>
                <p class="text-xs text-(--text-secondary) line-clamp-2">{concept.def[locale]}</p>
              </a>
            ))}
          </div>
        )}
      </div>
    )}

    {(!q || q.length < 2) && (
      <div class="text-center py-16 text-(--text-tertiary)">
        <p>{isKo ? '검색어를 입력하면 수학 개념을 찾을 수 있습니다' : 'Enter a search term to find math concepts'}</p>
        <p class="text-sm mt-2">
          {isKo ? (
            <><a href="/ko/browse" class="text-(--accent-primary) hover:underline">분야별 탐색</a>도 가능합니다</>
          ) : (
            <>Or <a href="/browse" class="text-(--accent-primary) hover:underline">browse by field</a></>
          )}
        </p>
      </div>
    )}
  </AppShell>
</BaseLayout>
