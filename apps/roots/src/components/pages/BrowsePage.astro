---
import { lightConcepts } from '../../../app/data/concepts';
import { fields } from '../../../app/data/fields';
import { filterConcepts } from '../../../app/lib/concept-filters';
import { getSubfieldsByParent } from '../../../app/data/subfields';
import { difficultyLabels } from '../../../app/data/types';
import AppShell from '../AppShell.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  locale: 'en' | 'ko';
}

const { locale } = Astro.props;
const isKo = locale === 'ko';
const localePrefix = isKo ? '/ko' : '';
const q = Astro.url.searchParams.get('q') ?? '';
const filterField = Astro.url.searchParams.get('field') ?? '';
const filtered = filterConcepts(lightConcepts, { field: filterField, query: q });
const selectedField = fields.find((field) => field.id === filterField);
const BASE_URL = 'https://roots.soundbluemusic.com';
---

<BaseLayout
  title={isKo ? '탐색 - 수리' : 'Browse - Roots'}
  description={isKo ? '18개 분야의 438개 수학 개념 탐색' : 'Browse 438 math concepts across 18 fields'}
  canonical={`${BASE_URL}${localePrefix}/browse`}
>
  <AppShell locale={locale}>
    <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) mb-6">{isKo ? '탐색' : 'Browse'}</h1>

    <form method="get" action={`${localePrefix}/browse`} class="mb-6 flex flex-col sm:flex-row gap-3">
      <div class="relative flex-1">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="absolute left-3 top-1/2 -translate-y-1/2 text-(--text-tertiary)"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="search"
          name="q"
          value={q}
          placeholder={isKo ? '개념 필터...' : 'Filter concepts...'}
          class="w-full pl-9 pr-4 py-2 rounded-lg border border-(--border-primary) bg-(--bg-elevated) text-(--text-primary) placeholder:text-(--text-tertiary) focus:outline-none focus:border-(--border-focus) transition-colors text-sm"
        />
      </div>
      <select
        name="field"
        class="px-3 py-2 rounded-lg border border-(--border-primary) bg-(--bg-elevated) text-(--text-primary) focus:outline-none focus:border-(--border-focus) transition-colors text-sm"
      >
        <option value="">{isKo ? '모든 분야' : 'All fields'}</option>
        {fields.map((field) => (
          <option value={field.id} selected={filterField === field.id}>{field.name[locale]}</option>
        ))}
      </select>
      <button
        type="submit"
        class="px-4 py-2 rounded-lg bg-(--accent-primary) text-white font-medium hover:opacity-90 transition-opacity text-sm shrink-0"
      >
        {isKo ? '필터' : 'Filter'}
      </button>
    </form>

    {q || filterField ? (
      <div>
        <p class="text-sm text-(--text-tertiary) mb-4">
          {isKo ? `${filtered.length}개의 개념` : `${filtered.length} concept${filtered.length !== 1 ? 's' : ''}`}
          {q && (isKo ? <> "<strong class="text-(--text-primary)">{q}</strong>" 검색 결과</> : <> matching <strong class="text-(--text-primary)">"{q}"</strong></>)}
          {selectedField && (isKo ? <> - <strong class="text-(--text-primary)">{selectedField.name.ko}</strong> 분야</> : <> in <strong class="text-(--text-primary)">{selectedField.name.en}</strong></>)}
        </p>
        {filtered.length === 0 ? (
          <div class="text-center py-16">
            <p class="text-(--text-tertiary)">
              {isKo ? '결과가 없습니다. ' : 'No concepts found. '}
              <a href={`${localePrefix}/browse`} class="text-(--accent-primary) hover:underline">
                {isKo ? '필터 초기화' : 'Clear filters'}
              </a>
            </p>
          </div>
        ) : (
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {filtered.map((concept) => (
              <a
                href={`${localePrefix}/concept/${concept.id}`}
                class="block p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary) hover:border-(--accent-primary) transition-colors group"
              >
                <div class="flex items-start justify-between gap-2 mb-1.5">
                  <h2 class="text-sm font-medium text-(--text-primary) group-hover:text-(--accent-primary) transition-colors">
                    {concept.name[locale]}
                  </h2>
                  <span class="px-1.5 py-0.5 rounded text-xs bg-(--accent-mint) text-(--accent-primary) shrink-0">
                    {difficultyLabels[concept.difficulty]?.[locale] ?? String(concept.difficulty)}
                  </span>
                </div>
                <p class="text-xs text-(--text-secondary) line-clamp-2">{concept.def[locale]}</p>
              </a>
            ))}
          </div>
        )}
      </div>
    ) : (
      <div class="space-y-10">
        {fields.map((field) => {
          const fieldConcepts = lightConcepts.filter((concept) => concept.field === field.id);
          const subfields = getSubfieldsByParent(field.id);
          return (
            <section aria-labelledby={`field-${field.id}`}>
              <div class="flex items-center gap-3 mb-4">
                <span class="text-2xl">{field.icon}</span>
                <div>
                  <h2 id={`field-${field.id}`} class="text-lg font-semibold text-(--text-primary)">
                    <a href={`${localePrefix}/field/${field.id}`} class="hover:text-(--accent-primary) transition-colors">
                      {field.name[locale]}
                    </a>
                  </h2>
                  <p class="text-sm text-(--text-tertiary)">
                    {isKo ? `${fieldConcepts.length}개의 개념` : `${fieldConcepts.length} concepts`}
                  </p>
                </div>
              </div>
              {subfields.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-3">
                  {subfields.map((subfield) => (
                    <span class="px-2 py-0.5 rounded-full text-xs bg-(--bg-tertiary) text-(--text-secondary)">
                      {subfield.name[locale]}
                    </span>
                  ))}
                </div>
              )}
              <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
                {fieldConcepts.slice(0, 6).map((concept) => (
                  <a
                    href={`${localePrefix}/concept/${concept.id}`}
                    class="flex items-center gap-2 p-3 rounded-lg bg-(--bg-elevated) border border-(--border-primary) hover:border-(--accent-primary) transition-colors group text-sm"
                  >
                    <span class="flex-1 font-medium text-(--text-primary) group-hover:text-(--accent-primary) transition-colors truncate">
                      {concept.name[locale]}
                    </span>
                  </a>
                ))}
              </div>
              {fieldConcepts.length > 6 && (
                <div class="mt-2">
                  <a href={`${localePrefix}/field/${field.id}`} class="text-sm text-(--accent-primary) hover:underline">
                    {isKo ? `${fieldConcepts.length}개 전체 보기 →` : `View all ${fieldConcepts.length} concepts →`}
                  </a>
                </div>
              )}
            </section>
          );
        })}
      </div>
    )}
  </AppShell>
</BaseLayout>
