{
  "name": "roots",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/strip-bindings.mjs",
    "preview": "astro preview",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "astro check && tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@soundblue/config": "workspace:*",
    "@soundblue/core": "workspace:*",
    "@soundblue/i18n": "workspace:*",
    "@soundblue/seo": "workspace:*",
    "@soundblue/ui": "workspace:*",
    "astro": "7.4.12",
    "katex": "^0.19.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  },
  "engines": {
    "node": "^22.23.4 || ^24.15.0 || >=26.0.0"
  }
}
