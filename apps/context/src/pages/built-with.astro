---
import { getOpenSourceGrouped } from '@soundblue/core';
import AppShell from '../components/AppShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const BASE_URL = 'https://context.soundbluemusic.com';
const groups = getOpenSourceGrouped();
---

<BaseLayout
  title="Open Source - Context"
  description="Open source libraries used in this project"
  canonical={`${BASE_URL}/built-with`}
>
  <AppShell locale="en">
    <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) mb-8">Open Source</h1>
    <div class="space-y-6">
      {groups.map((group) => (
        <section>
          <h2 class="text-sm font-medium text-(--text-tertiary) mb-2">{group.label.en}</h2>
          <div class="divide-y divide-(--border-primary) border-y border-(--border-primary)">
            {group.projects.map((project) => (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-between py-3 px-1 hover:bg-(--bg-secondary) transition-colors"
              >
                <span class="font-medium text-(--text-primary)">{project.name}</span>
                <span class="text-(--text-tertiary)">&rsaquo;</span>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </AppShell>
</BaseLayout>
