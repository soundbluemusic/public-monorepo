---
import AppShell from '../components/AppShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const BASE_URL = 'https://context.soundbluemusic.com';

const pages = [
  { path: '/', labelEn: 'Home' },
  { path: '/browse', labelEn: 'Browse' },
  { path: '/conversations', labelEn: 'Conversations' },
  { path: '/tags', labelEn: 'Tags' },
  { path: '/download', labelEn: 'Download' },
  { path: '/about', labelEn: 'About' },
];

const xmlSitemaps = [
  { path: '/sitemap.xml', label: 'Sitemap Index' },
  { path: '/sitemap-pages.xml', label: 'Pages Sitemap' },
  { path: '/sitemap-categories.xml', label: 'Categories Sitemap' },
];
---

<BaseLayout
  title="Sitemap - Context"
  description="Complete list of all pages on Context"
  canonical={`${BASE_URL}/sitemap`}
>
  <AppShell locale="en">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-2xl font-bold text-(--text-primary) mb-2">Sitemap</h1>
      <p class="text-(--text-secondary) mb-8">View all pages on Context at a glance.</p>

      <section class="mb-8">
        <h2 class="text-xl font-semibold text-(--text-primary) mb-4">All Pages</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {pages.map((page) => (
            <a
              href={page.path}
              class="flex items-center gap-3 p-3 rounded-lg bg-(--bg-elevated) border border-(--border-primary) no-underline transition-all hover:border-(--border-focus) hover:shadow-sm"
            >
              <span class="text-(--text-primary) font-medium">{page.labelEn}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="p-6 rounded-xl bg-(--bg-elevated) border border-(--border-primary)">
        <h2 class="text-lg font-semibold text-(--text-primary) mb-2">Search Engine Sitemap</h2>
        <p class="text-sm text-(--text-secondary) mb-4">XML sitemaps used by search engines to index this site.</p>
        <ul class="space-y-3">
          {xmlSitemaps.map((sitemap) => (
            <li>
              <a
                href={sitemap.path}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-(--accent-primary) hover:underline"
              >
                {sitemap.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </AppShell>
</BaseLayout>
