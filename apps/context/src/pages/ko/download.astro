---
import AppShell from '../../components/AppShell.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const BASE_URL = 'https://context.soundbluemusic.com';
---

<BaseLayout
  title="어휘 다운로드 - Context"
  description="오프라인 사용을 위한 한국어 어휘 데이터 다운로드"
  canonical={`${BASE_URL}/ko/download`}
>
  <AppShell locale="ko">
    <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) mb-4">어휘 다운로드</h1>
    <p class="text-(--text-secondary) mb-8">오프라인 사용이나 연구 목적으로 한국어 어휘 데이터를 다운로드하세요.</p>

    <div class="space-y-4">
      <div class="p-5 rounded-xl bg-(--bg-elevated) border border-(--border-primary)">
        <h2 class="text-base font-semibold text-(--text-primary) mb-2">오프라인 데이터베이스</h2>
        <p class="text-sm text-(--text-secondary) mb-4">앱에서 오프라인으로 접근하기 위한 전체 어휘 데이터베이스를 다운로드하세요.</p>
        <a
          href="/api/offline-db"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-(--accent-primary) text-white text-sm font-medium hover:brightness-110 transition-all"
        >
          JSON 다운로드
        </a>
      </div>

      <div class="p-5 rounded-xl bg-(--bg-elevated) border border-(--border-primary)">
        <h2 class="text-base font-semibold text-(--text-primary) mb-2">원본 데이터 (GitHub)</h2>
        <p class="text-sm text-(--text-secondary) mb-4">GitHub에서 원본 데이터 파일에 접근하세요.</p>
        <a
          href="https://github.com/soundbluemusic/public-monorepo/tree/main/data/context"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-(--bg-tertiary) text-(--text-primary) text-sm font-medium hover:bg-(--bg-secondary) transition-colors border border-(--border-primary)"
        >
          GitHub에서 보기
        </a>
      </div>
    </div>
  </AppShell>
</BaseLayout>
