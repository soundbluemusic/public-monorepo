---
import AppShell from '../../components/AppShell.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const BASE_URL = 'https://context.soundbluemusic.com';
---

<BaseLayout
  title="내 학습 - Context"
  description="한국어 어휘 학습 진도 추적"
  canonical={`${BASE_URL}/ko/my-learning`}
  noIndex={true}
>
  <AppShell locale="ko">
    <h1 class="text-2xl font-bold text-(--text-primary) mb-6">내 학습</h1>
    <div id="my-learning-content">
      <p class="text-(--text-secondary) mb-4">학습 데이터를 불러오는 중...</p>
    </div>
  </AppShell>
</BaseLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const content = document.getElementById('my-learning-content');
    if (!content) return;

    try {
      const studyData = JSON.parse(localStorage.getItem('context-study-records') ?? '[]');
      const favoriteData = JSON.parse(localStorage.getItem('context-favorites') ?? '[]');

      if (studyData.length === 0 && favoriteData.length === 0) {
        content.innerHTML = `
          <div class="text-center py-16">
            <p class="text-(--text-secondary) mb-4">아직 학습 데이터가 없어요. 단어를 학습해 보세요!</p>
            <a href="/ko/browse" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-(--accent-primary) text-white text-sm font-medium hover:brightness-110 transition-all">
              단어 탐색 →
            </a>
          </div>
        `;
      } else {
        content.innerHTML = `
          <div class="space-y-4">
            <div class="p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary)">
              <p class="text-sm text-(--text-tertiary) mb-1">학습한 단어</p>
              <p class="text-3xl font-bold text-(--text-primary)">${studyData.length}</p>
            </div>
            <div class="p-4 rounded-xl bg-(--bg-elevated) border border-(--border-primary)">
              <p class="text-sm text-(--text-tertiary) mb-1">북마크</p>
              <p class="text-3xl font-bold text-(--text-primary)">${favoriteData.length}</p>
            </div>
            <a href="/ko/browse" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-(--accent-primary) text-white text-sm font-medium hover:brightness-110 transition-all">
              계속 학습하기 →
            </a>
          </div>
        `;
      }
    } catch {
      content.innerHTML = '<p class="text-(--text-secondary)">학습 데이터를 불러올 수 없습니다.</p>';
    }
  });
</script>
