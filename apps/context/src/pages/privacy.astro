---
import AppShell from '../components/AppShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const BASE_URL = 'https://context.soundbluemusic.com';
---

<BaseLayout
  title="Privacy Policy - Context"
  canonical={`${BASE_URL}/privacy`}
>
  <AppShell locale="en">
    <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) mb-6">Privacy Policy</h1>
    <div class="text-(--text-secondary)">
      <p>This site does not collect any personal information. All data is stored locally on your device.</p>
    </div>
  </AppShell>
</BaseLayout>
