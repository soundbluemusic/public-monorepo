---
import AppShell from '../AppShell.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  locale: 'en' | 'ko';
}

const { locale } = Astro.props;
const isKo = locale === 'ko';
const BASE_URL = 'https://context.soundbluemusic.com';
---

<BaseLayout
  title={isKo ? '이용약관 - Context' : 'Terms of Service - Context'}
  canonical={`${BASE_URL}${isKo ? '/ko' : ''}/terms`}
>
  <AppShell locale={locale}>
    <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) mb-6">
      {isKo ? '이용약관' : 'Terms of Service'}
    </h1>
    <div class="text-(--text-secondary)">
      <p>
        {isKo
          ? '이 사이트를 사용함으로써 귀하는 다음 약관에 동의하는 것으로 간주됩니다. 모든 콘텐츠는 교육 목적으로 제공되며, 상업적 사용이 가능합니다.'
          : 'By using this site, you agree to the following terms. All content is provided for educational purposes and may be used commercially.'}
      </p>
    </div>
  </AppShell>
</BaseLayout>
