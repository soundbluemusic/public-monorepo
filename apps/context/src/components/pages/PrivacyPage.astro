---
import AppShell from '../AppShell.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  locale: 'en' | 'ko';
}

const { locale } = Astro.props;
const isKo = locale === 'ko';
const BASE_URL = 'https://context.soundbluemusic.com';
---

<BaseLayout
  title={isKo ? '개인정보처리방침 - Context' : 'Privacy Policy - Context'}
  canonical={`${BASE_URL}${isKo ? '/ko' : ''}/privacy`}
>
  <AppShell locale={locale}>
    <h1 class="text-2xl sm:text-3xl font-bold text-(--text-primary) mb-6">
      {isKo ? '개인정보처리방침' : 'Privacy Policy'}
    </h1>
    <div class="text-(--text-secondary)">
      <p>
        {isKo
          ? '이 사이트는 사용자의 개인정보를 수집하지 않습니다. 모든 데이터는 로컬 스토리지에만 저장됩니다.'
          : 'This site does not collect any personal information. All data is stored locally on your device.'}
      </p>
    </div>
  </AppShell>
</BaseLayout>
