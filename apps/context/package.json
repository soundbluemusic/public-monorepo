{
  "name": "context",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "tsx scripts/generate-browse-chunks.ts",
    "build": "vite build",
    "postbuild": "node scripts/inject-polyfill.mjs && tsx ../../scripts/generate-sw.ts context",
    "sitemap": "tsx scripts/generate-sitemaps.ts",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "seed:prod": "tsx scripts/seed.ts",
    "seed:local": "tsx scripts/seed.ts --local",
    "seed:dry-run": "tsx scripts/seed.ts --dry-run"
  },
  "dependencies": {
    "@soundblue/config": "workspace:*",
    "@soundblue/core": "workspace:*",
    "@soundblue/features": "workspace:*",
    "@soundblue/i18n": "workspace:*",
    "@soundblue/pwa": "workspace:*",
    "@soundblue/search": "workspace:*",
    "@soundblue/seo": "workspace:*",
    "@soundblue/ui": "workspace:*",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/react-start": "^1.167.43",
    "lucide-react": "^1.9.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.1",
    "@cloudflare/workers-types": "^4.20260424.1",
    "@inlang/paraglide-js": "^2.16.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "wrangler": "^4.84.1"
  },
  "engines": {
    "node": ">=20"
  }
}
