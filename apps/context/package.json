{
  "name": "context",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "tsx scripts/generate-browse-chunks.ts",
    "build": "vite build",
    "postbuild": "node scripts/inject-polyfill.mjs && tsx ../../scripts/generate-sw.ts context",
    "sitemap": "tsx scripts/generate-sitemaps.ts",
    "deploy": "pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "seed:prod": "tsx scripts/seed.ts",
    "seed:local": "tsx scripts/seed.ts --local",
    "seed:dry-run": "tsx scripts/seed.ts --dry-run"
  },
  "dependencies": {
    "@soundblue/config": "workspace:*",
    "@soundblue/core": "workspace:*",
    "@soundblue/features": "workspace:*",
    "@soundblue/i18n": "workspace:*",
    "@soundblue/pwa": "workspace:*",
    "@soundblue/search": "workspace:*",
    "@soundblue/seo": "workspace:*",
    "@soundblue/ui": "workspace:*",
    "@tanstack/react-router": "^1.157.2",
    "@tanstack/react-start": "^1.157.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.3",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.21.1",
    "@cloudflare/workers-types": "^4.20260109.0",
    "@inlang/paraglide-js": "^2.9.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "8.0.0-beta.9",
    "wrangler": "^4.60.0"
  },
  "engines": {
    "node": ">=20"
  }
}
