{
  "name": "public-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev:context": "pnpm --filter context dev",
    "dev:permissive": "pnpm --filter permissive dev",
    "dev:roots": "pnpm --filter roots dev",
    "dev:docs": "pnpm --filter docs dev",
    "build": "turbo build",
    "build:context": "turbo build --filter=context",
    "build:permissive": "turbo build --filter=permissive",
    "build:roots": "turbo build --filter=roots",
    "build:docs": "turbo build --filter=docs",
    "build:test": "turbo typecheck && turbo build && pnpm verify:ssr",
    "verify:ssr": "tsx scripts/verify-html.ts",
    "preview": "pnpm --filter roots preview",
    "preview:context": "pnpm --filter context preview",
    "preview:permissive": "pnpm --filter permissive preview",
    "preview:roots": "pnpm --filter roots preview",
    "deploy:ssr": "pnpm --filter context run deploy && pnpm --filter permissive run deploy && pnpm --filter roots run deploy",
    "deploy:ssr:context": "pnpm --filter context run deploy",
    "deploy:ssr:permissive": "pnpm --filter permissive run deploy",
    "deploy:ssr:roots": "pnpm --filter roots run deploy",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:circular": "skott --displayMode=raw --showCircularDependencies --fileExtensions=.ts,.tsx --ignorePattern='**/build/**' --ignorePattern='**/node_modules/**' --ignorePattern='**/routeTree.gen.ts' --cwd=apps && skott --displayMode=raw --showCircularDependencies --fileExtensions=.ts,.tsx --ignorePattern='**/build/**' --ignorePattern='**/node_modules/**' --cwd=packages",
    "check:versions": "syncpack lint",
    "check:size": "size-limit",
    "check:links": "tsx scripts/check-links.ts",
    "check:links:prod": "./scripts/check-links-prod.sh",
    "check:deprecated": "tsx scripts/check-deprecated-imports.ts",
    "quality": "tsx scripts/quality-gate.ts",
    "quality:quick": "tsx scripts/quality-gate.ts --quick",
    "lhci": "lhci autorun",
    "lhci:context": "APP=context lhci autorun",
    "lhci:permissive": "APP=permissive lhci autorun",
    "lhci:roots": "APP=roots lhci autorun",
    "lhci:all": "pnpm lhci:context && pnpm lhci:permissive && pnpm lhci:roots",
    "add-data": "tsx scripts/add-data.ts",
    "sync:stats": "tsx scripts/sync-stats.ts",
    "prepare": "husky",
    "postinstall": "pnpm --filter @soundblue/config build && pnpm --filter './apps/*' prebuild",
    "prebuild:all": "pnpm --filter './apps/*' prebuild",
    "storybook": "pnpm --filter @soundblue/ui storybook",
    "build-storybook": "pnpm --filter @soundblue/ui build-storybook"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.12",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@formkit/auto-animate": "^0.10.0",
    "@hookform/resolvers": "^5.9.1",
    "@inlang/paraglide-js": "^2.25.0",
    "@inlang/plugin-message-format": "^4.4.4",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@resvg/resvg-js": "^2.6.2",
    "@rsbuild/core": "^2.2.3",
    "@size-limit/file": "^13.0.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-virtual": "^3.14.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3": "^7.4.3",
    "@types/jest-axe": "^3.5.9",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "axe-core": "^4.13.0",
    "class-variance-authority": "^0.7.1",
    "d3": "^7.9.0",
    "dexie": "^4.4.5",
    "fake-indexeddb": "^6.2.5",
    "framer-motion": "^13.2.0",
    "glob": "^13.0.6",
    "happy-dom": "^20.14.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.4.1",
    "nanoid": "^6.0.1",
    "pixelmatch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "size-limit": "^13.0.3",
    "skott": "^0.35.11",
    "syncpack": "^15.3.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "workbox-build": "^7.4.1",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^9.2.4"
  }
}
