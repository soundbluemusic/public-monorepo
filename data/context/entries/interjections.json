      "ko": {
        "word": "와",
        "explanation": "와의 뜻은 'Wow'입니다.",
        "examples": {
          "beginner": "와! 놀랐어요.",
          "intermediate": "한국 사람들은 \"와\"을 자주 말해요.",
          "advanced": "\"와\"은 감정을 즉각적으로 표현하는 감탄사입니다.",
          "master": "\"와\"의 사용 빈도와 맥락은 한국어 화자의 감정 표현 방식을 보여줍니다."
        },
        "variations": {
          "formal": [
            "와입니다.",
            "와이/가 있습니다."
          ],
          "casual": [
            "와이야.",
            "와 있어."
          ],
          "short": [
            "와"
          ]
        },
        "dialogue": {
          "context": "놀라운 일이 생겼을 때",
          "dialogue": [
            {
              "speaker": "A",
              "text": "와! 이거 봐요!",
              "romanization": "wa! igeo bwayo!",
              "translation": "Wow! Look at this!"
            },
            {
              "speaker": "B",
              "text": "뭔데요?",
              "romanization": "mwondeyo?",
              "translation": "What is it?"
            },
            {
              "speaker": "A",
              "text": "정말 신기하지 않아요?",
              "romanization": "jeongmal singihaji anayo?",
              "translation": "Isn't it amazing?"
            },
            {
              "speaker": "B",
              "text": "와, 진짜 신기하네요!",
              "romanization": "wa, jinjja singihaneyo!",
              "translation": "Wow, that's really amazing!"
            }
          ]
        }
      },
      "en": {
        "word": "Wow",
        "explanation": "'와' means 'Wow' in English.",
        "examples": {
          "beginner": "와! I was surprised.",
          "intermediate": "Korean people often say \"와\".",
          "advanced": "\"와\" is an interjection that immediately expresses emotion.",
          "master": "The frequency and context of \"와\" reveals how Korean speakers express emotions."
        },
        "variations": {
          "formal": [
            "It is Wow.",
            "There is Wow."
          ],
          "casual": [
