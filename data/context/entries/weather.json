          "advanced": "비가 그치고 하늘이 맑게 개었다.",
          "master": "가을 하늘은 높고 맑아서 천고마비의 계절이라고 한다."
        },
        "variations": {
          "formal": ["날씨가 맑습니다.", "하늘이 맑습니다."],
          "casual": ["날씨 맑다.", "하늘 진짜 맑다."],
          "short": ["맑음"]
        },
        "dialogue": {
          "context": "날씨 예보를 보며",
          "dialogue": [
            {"speaker": "A", "text": "내일 날씨 어때?", "romanization": "naeil nalssi eottae?", "translation": "How's the weather tomorrow?"},
            {"speaker": "B", "text": "맑대! 소풍 가자.", "romanization": "maktae! sopung gaja.", "translation": "It'll be clear! Let's go on a picnic."}
          ]
        }
      },
      "en": {
        "word": "clear (weather)",
        "explanation": "Describes clear, cloudless weather. Also used to describe anything transparent or pure, such as clear water or a clear voice.",
        "examples": {
          "beginner": "The weather is clear today.",
          "intermediate": "I want to take a walk on a clear day.",
          "advanced": "The rain stopped and the sky cleared up.",
          "master": "Autumn skies are high and clear — that's why it's called the season of high skies."
        },
        "variations": {
          "formal": ["The weather is clear.", "The sky is clear."],
          "casual": ["It's clear out.", "Nice and clear."],
          "short": ["clear"]
        },
        "dialogue": {
          "context": "Checking the weather forecast",
          "dialogue": [
            {"speaker": "A", "text": "How's the weather tomorrow?", "romanization": "", "translation": "내일 날씨 어때?"},
            {"speaker": "B", "text": "It'll be clear! Let's go on a picnic.", "romanization": "", "translation": "맑대! 소풍 가자."}
          ]
        }
      }
    },
    "pronunciation": {
      "korean": "[막따]",
      "ipa": "[mak̚.t͈a]"
    }
