        "variations": {
          "formal": ["It is raining.", "Rain is falling."],
          "casual": ["It's raining.", "Rain's coming down."],
          "short": ["rain"]
        },
        "dialogue": {
          "context": "Getting ready to go out in the morning",
          "dialogue": [
            {"speaker": "A", "text": "Is it raining outside?", "romanization": "", "translation": "밖에 비 와?"},
            {"speaker": "B", "text": "Yeah, bring an umbrella.", "romanization": "", "translation": "응, 우산 챙겨."}
          ]
        }
      }
