      "en": {
        "word": "hot (weather)",
        "explanation": "Describes hot weather or feeling warm due to high temperature. This adjective follows the 'ㅂ' irregular conjugation: 덥다 → 더워요 (present), 더운 (modifier).",
        "examples": {
          "beginner": "It's very hot today.",
          "intermediate": "In summer it's really hot, so you need air conditioning.",
          "advanced": "It feels suffocating in the sweltering heat.",
          "master": "The perceived temperature exceeded 40°C and a heat wave warning was issued."
        },
        "variations": {
          "formal": ["The weather is hot.", "The temperature is high."],
          "casual": ["It's hot.", "So hot."],
          "short": ["hot"]
        },
        "dialogue": {
          "context": "On a hot midsummer day",
          "dialogue": [
            {"speaker": "A", "text": "Ah, it's so hot.", "romanization": "", "translation": "아, 너무 더워."},
            {"speaker": "B", "text": "Let's go get ice cream.", "romanization": "", "translation": "아이스크림 먹으러 가자."}
          ]
        }
      }
    },
    "pronunciation": {
      "korean": "[덥따]",
      "ipa": "[tʌp̚.t͈a]"
