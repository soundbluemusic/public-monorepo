        "examples": {
          "beginner": "오늘 비가 와요.",
          "intermediate": "장마철에는 비가 자주 내려요.",
          "advanced": "가을비가 추적추적 내리고 있다.",
          "master": "비가 오다가 갑자기 개었다."
        },
        "variations": {
          "formal": ["비가 내리고 있습니다.", "비가 오고 있습니다."],
