  {
    "id": "nun",
    "korean": "눈",
    "romanization": "nun",
    "partOfSpeech": "noun",
    "categoryId": "weather",
    "difficulty": "beginner",
    "frequency": "common",
    "tags": ["weather", "nature", "winter"],
    "hasDialogue": true,
    "translations": {
      "ko": {
        "word": "눈",
        "explanation": "하늘에서 얼음 결정이 내리는 기상 현상입니다. '눈'은 동음이의어로 신체 부위(eye)도 뜻합니다. 문맥으로 구분합니다.",
        "examples": {
          "beginner": "눈이 와요!",
          "intermediate": "첫눈이 내렸어요.",
          "advanced": "함박눈이 펑펑 쏟아지고 있다.",
          "master": "눈이 녹아서 길이 미끄럽다."
        },
        "variations": {
          "formal": ["눈이 내리고 있습니다.", "눈이 오고 있습니다."],
          "casual": ["눈 온다!", "눈이야!"],
          "short": ["눈"]
        },
        "dialogue": {
          "context": "창밖을 보며",
          "dialogue": [
            {"speaker": "A", "text": "와, 눈이다!", "romanization": "wa, nunida!", "translation": "Wow, it's snowing!"},
            {"speaker": "B", "text": "첫눈이네! 소원 빌어.", "romanization": "cheonnunine! sowon bireo.", "translation": "It's the first snow! Make a wish."}
          ]
        }
      },
      "en": {
        "word": "snow",
        "explanation": "Snow, frozen precipitation in the form of ice crystals. The word '눈' is a homonym that also means 'eye' in Korean — context determines the meaning. In Korean culture, the first snow (첫눈) is considered romantic.",
        "examples": {
          "beginner": "It's snowing!",
          "intermediate": "The first snow has fallen.",
          "advanced": "Big fluffy snowflakes are pouring down.",
          "master": "The snow has melted and the roads are slippery."
        },
        "variations": {
          "formal": ["It is snowing.", "Snow is falling."],
          "casual": ["It's snowing!", "Snow!"],
          "short": ["snow"]
        },
        "dialogue": {
          "context": "Looking out the window",
          "dialogue": [
            {"speaker": "A", "text": "Wow, it's snowing!", "romanization": "", "translation": "와, 눈이다!"},
            {"speaker": "B", "text": "It's the first snow! Make a wish.", "romanization": "", "translation": "첫눈이네! 소원 빌어."}
          ]
        }
      }
    },
    "pronunciation": {
      "korean": "[눈]",
      "ipa": "[nun]"
    }
  },
