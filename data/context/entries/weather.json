        },
        "variations": {
          "formal": ["바람이 불고 있습니다.", "강풍이 예상됩니다."],
          "casual": ["바람 분다.", "바람 엄청 세다."],
          "short": ["바람"]
        },
        "dialogue": {
          "context": "산책하면서",
          "dialogue": [
            {"speaker": "A", "text": "바람이 시원하다.", "romanization": "barami siwonhada.", "translation": "The wind feels refreshing."},
            {"speaker": "B", "text": "그러게, 산책하기 딱 좋은 날씨야.", "romanization": "geureoge, sanchaekhagi ttak joeun nalssiya.", "translation": "Right, it's perfect weather for a walk."}
          ]
        }
      },
      "en": {
        "word": "wind",
        "explanation": "The movement of air. In Korean, '바람' is also used idiomatically: '바람을 피우다' means 'to have an affair,' and '바람이 불다' can mean 'a trend is emerging.'",
        "examples": {
          "beginner": "The wind is blowing.",
          "intermediate": "It's cold today because the wind is blowing a lot.",
          "advanced": "When cold winds start blowing, winter has arrived.",
          "master": "A gentle breeze blew and the leaves swayed softly."
        },
        "variations": {
          "formal": ["The wind is blowing.", "Strong winds are expected."],
          "casual": ["It's windy.", "Wind's really strong."],
          "short": ["wind"]
        },
        "dialogue": {
          "context": "While taking a walk",
          "dialogue": [
            {"speaker": "A", "text": "The wind feels refreshing.", "romanization": "", "translation": "바람이 시원하다."},
            {"speaker": "B", "text": "Right, it's perfect weather for a walk.", "romanization": "", "translation": "그러게, 산책하기 딱 좋은 날씨야."}
          ]
        }
      }
    },
    "pronunciation": {
      "korean": "[바람]",
      "ipa": "[pa.ɾam]"
    }
