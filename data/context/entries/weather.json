          "master": "체감 온도가 40도를 넘어 폭염 경보가 내려졌다."
        },
        "variations": {
          "formal": ["날씨가 덥습니다.", "기온이 높습니다."],
          "casual": ["더워.", "너무 덥다."],
          "short": ["덥다"]
        },
        "dialogue": {
          "context": "한여름 더운 날",
          "dialogue": [
            {"speaker": "A", "text": "아, 너무 더워.", "romanization": "a, neomu deowo.", "translation": "Ah, it's so hot."},
            {"speaker": "B", "text": "아이스크림 먹으러 가자.", "romanization": "aiseukeulim meogeureo gaja.", "translation": "Let's go get ice cream."}
          ]
        }
