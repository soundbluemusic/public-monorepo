    "translations": {
      "ko": {
        "word": "ㅐ (애)",
        "explanation": "ㅏ와 ㅣ가 합쳐진 복합 모음입니다. 현대 한국어에서는 ㅔ와 거의 같은 소리로 발음됩니다.",
        "examples": {
          "beginner": "\"ㅐ\" 소리를 내 봐요.",
          "intermediate": "\"ㅐ\"가 들어가는 단어를 찾아봐요.",
          "advanced": "\"ㅐ\"의 정확한 발음은 한국어 학습의 기본입니다.",
          "master": "\"ㅐ\"의 음성학적 특성을 이해하면 발음이 정확해집니다."
        },
        "variations": {
          "formal": [
            "이 글자는 ㅐ입니다.",
            "ㅐ는 ㅏ와 ㅣ의 합성 모음입니다."
          ],
          "casual": [
            "이거 ㅐ야.",
            "애~ 하고 소리 내 봐."
          ],
          "short": [
            "애"
          ]
        },
        "dialogue": {
          "context": "발음을 연습하며",
          "dialogue": [
            {
              "speaker": "A",
              "text": "\"ㅐ\" 발음이 어려워요.",
              "romanization": "\"ㅐ\" baleumi eoryeowoyo.",
              "translation": "The \"ㅐ\" pronunciation is hard."
            },
            {
              "speaker": "B",
              "text": "입 모양을 잘 봐요.",
              "romanization": "ip moyangeul jal bwayo.",
              "translation": "Watch the mouth shape carefully."
            },
            {
              "speaker": "A",
              "text": "\"ㅐ\"... 이렇게요?",
              "romanization": "\"ㅐ\"... ireotgeyo?",
              "translation": "\"ㅐ\"... like this?"
            },
            {
              "speaker": "B",
              "text": "맞아요, 잘했어요!",
              "romanization": "matayo, jalhaeseoyo!",
              "translation": "That's right, well done!"
            }
          ]
        }
      },
      "en": {
        "word": "ae (ㅐ)",
