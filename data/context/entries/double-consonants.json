      "ko": {
        "word": "ㄲ (쌍기역)",
        "explanation": "ㄱ을 두 번 쓴 된소리(경음) 글자입니다. 목을 긴장시키고 세게 발음합니다. '까', '꼬', '꾸' 등에 쓰입니다.",
        "examples": {
          "beginner": "\"ㄲ\" 소리를 내 봐요.",
          "intermediate": "\"ㄲ\"으로 시작하는 단어를 찾아봐요.",
          "advanced": "\"ㄲ\"의 발음 위치와 방법을 이해하면 정확한 발음이 가능합니다.",
          "master": "\"ㄲ\"의 음운론적 특성은 한국어 발음 체계의 핵심입니다."
        },
        "variations": {
          "formal": [
            "이 글자는 쌍기역입니다.",
            "ㄲ은 ㄱ의 된소리입니다."
          ],
          "casual": [
            "이거 쌍기역이야.",
            "ㄱ 두 개 합친 거야."
          ],
          "short": [
            "ㄲ"
          ]
        },
        "dialogue": {
          "context": "발음을 연습하며",
          "dialogue": [
            {
              "speaker": "A",
              "text": "\"ㄲ\" 발음이 어려워요.",
              "romanization": "\"ㄲ\" baleumi eoryeowoyo.",
              "translation": "The \"ㄲ\" pronunciation is difficult."
            },
            {
              "speaker": "B",
              "text": "천천히 따라해 봐요.",
              "romanization": "cheoncheonhi ttarahae bwayo.",
              "translation": "Try repeating slowly."
            },
            {
              "speaker": "A",
              "text": "\"ㄲ\"... 이렇게요?",
              "romanization": "\"ㄲ\"... ireotgeyo?",
              "translation": "\"ㄲ\"... like this?"
            },
            {
              "speaker": "B",
              "text": "잘했어요!",
              "romanization": "jalhaeseoyo!",
              "translation": "Well done!"
            }
          ]
        }
      },
      "en": {
        "word": "ssang-giyeok (ㄲ)",
        "explanation": "A tense (fortis) consonant, written as double ㄱ. Pronounced with a tight throat and no aspiration. Similar to an unaspirated 'k' in English 'skill'.",
