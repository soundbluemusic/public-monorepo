            "This letter is ssang-giyeok.",
            "ㄲ is the tense form of ㄱ."
          ],
          "casual": [
            "This is ssang-giyeok.",
            "It's like ㄱ but stronger."
          ],
          "short": [
            "ㄲ"
          ]
        },
        "dialogue": {
          "context": "Practicing pronunciation",
          "dialogue": [
            {
              "speaker": "A",
              "text": "The \"ㄲ\" pronunciation is difficult.",
              "romanization": "",
