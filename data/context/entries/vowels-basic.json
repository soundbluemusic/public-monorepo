    "hasDialogue": true,
    "translations": {
      "ko": {
        "word": "ㅏ (아)",
        "explanation": "한글 기본 모음 첫 번째 글자. 입을 크게 벌리고 내는 밝은 소리입니다. 양성 모음에 해당합니다.",
        "examples": {
          "beginner": "\"ㅏ\" 소리를 내 봐요.",
          "intermediate": "\"ㅏ\"가 들어가는 단어를 찾아봐요.",
          "advanced": "\"ㅏ\"의 정확한 발음은 한국어 학습의 기본입니다.",
          "master": "\"ㅏ\"의 음성학적 특성을 이해하면 발음이 정확해집니다."
        },
        "variations": {
          "formal": [
            "이 글자는 ㅏ입니다.",
            "ㅏ는 기본 모음의 첫 번째입니다."
          ],
          "casual": [
            "이거 ㅏ야.",
            "아~ 하고 소리 내 봐."
          ],
          "short": [
            "아"
          ]
        },
        "dialogue": {
          "context": "발음을 연습하며",
          "dialogue": [
            {
              "speaker": "A",
              "text": "\"ㅏ\" 발음이 어려워요.",
              "romanization": "\"ㅏ\" baleumi eoryeowoyo.",
              "translation": "The \"ㅏ\" pronunciation is hard."
            },
            {
              "speaker": "B",
              "text": "입 모양을 잘 봐요.",
              "romanization": "ip moyangeul jal bwayo.",
              "translation": "Watch the mouth shape carefully."
            },
            {
              "speaker": "A",
              "text": "\"ㅏ\"... 이렇게요?",
              "romanization": "\"ㅏ\"... ireotgeyo?",
              "translation": "\"ㅏ\"... like this?"
            },
            {
              "speaker": "B",
              "text": "맞아요, 잘했어요!",
              "romanization": "matayo, jalhaeseoyo!",
              "translation": "That's right, well done!"
            }
          ]
        }
      },
      "en": {
        "word": "a (ㅏ)",
        "explanation": "The first basic vowel of the Korean alphabet. Pronounced like 'a' in 'father'. It is a bright, yang vowel.",
